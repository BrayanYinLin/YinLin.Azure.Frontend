---
interface Props {
  name: 'plus' | 'check';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  plus: 'M12 5v14M5 12h14',
  check: 'M5 12.5l4.5 4.5L19 7.5',
};
---

<svg
  class:list={['size-3', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
