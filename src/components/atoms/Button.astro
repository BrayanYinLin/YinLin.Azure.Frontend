---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'outline';
}
const { variant = 'outline', class: className, ...rest } = Astro.props;
const variants = {
  primary: 'bg-accent text-white px-5 py-3 font-medium hover:bg-accent/90',
  outline: 'bg-surface text-muted border border-line px-4 py-2 hover:text-ink',
};
---

<button
  class:list={[
    'inline-flex items-center justify-center gap-1 rounded-lg text-xs transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</button>
