---
import type { HTMLAttributes } from 'astro/types';
import Label from '../atoms/Label.astro';
import Input from '../atoms/Input.astro';

interface Props extends HTMLAttributes<'input'> {
  id: string;
  label: string;
}
const { id, label, class: className, ...rest } = Astro.props;
---

<div class:list={['flex flex-col gap-1.5', className]}>
  <Label for={id}>{label}</Label>
  <Input id={id} name={id} aria-describedby={`${id}-error`} {...rest} />
  <p id={`${id}-error`} data-error-for={id} class="text-[11px] text-red-700" hidden></p>
</div>
