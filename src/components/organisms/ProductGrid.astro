---
import type { Product } from '../../lib/api/types';
import ProductCard from '../molecules/ProductCard.astro';
import EmptyState from '../molecules/EmptyState.astro';

interface Props {
  products: Product[];
  failed?: boolean;
}
const { products, failed = false } = Astro.props;
---

{
  failed ? (
    <EmptyState title="No pudimos cargar los productos" description="Inténtalo de nuevo en unos minutos." />
  ) : products.length === 0 ? (
    <EmptyState title="No hay productos disponibles" />
  ) : (
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((product) => <ProductCard product={product} />)}
    </ul>
  )
}
